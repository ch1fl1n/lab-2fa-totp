# Copia este archivo a .env y completa los valores.

# Supabase: Project Settings -> API. Usa la service_role key (solo en el backend, nunca en la app).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Emisor que aparece en el authenticator
TOTP_ISSUER=Lab2FA

# 1 = base de datos en memoria (para probar sin Supabase; se borra al reiniciar)
USE_MEMORY_DB=0

# Servidor local de Prefect (prefect server start)
PREFECT_API_URL=http://127.0.0.1:4200/api
